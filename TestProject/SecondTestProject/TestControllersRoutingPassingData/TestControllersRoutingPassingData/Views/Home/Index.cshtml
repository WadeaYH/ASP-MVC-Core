@{
    ViewData["Title"] = "Home Page";
}

<h1>Controllers, Routing and Passing Data</h1>

<ul>
    <li><a href="/Students">/Students</a> : View + ViewData + ViewBag + list</li>
    <li><a href="/Students/Hello">/Students/Hello</a> : Content()</li>
    <li><a href="/Students/Details/5">/Students/Details/5</a> : conventional route with id</li>
    <li><a href="/Students/Create">/Students/Create</a> : GET form, POST, redirect, TempData</li>
    <li><a href="/courses">/courses</a> : attribute routing</li>
    <li><a href="/courses/3">/courses/3</a> : attribute route with {id:int}</li>
</ul>
