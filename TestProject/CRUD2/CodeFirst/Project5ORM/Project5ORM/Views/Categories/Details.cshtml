@using Project5ORM.Models.CodeFirst

@model Category
@{
    ViewData["Title"] = "Category Details";
}

<h2>Category Details</h2>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Id)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Name)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Description)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Description)</dd>
</dl>

@Html.ActionLink("Edit", "Edit", "Categories", new { id = Model.Id }, new { @class = "btn btn-warning" })
@Html.ActionLink("Back to list", "Index", "Categories", null, new { @class = "btn btn-secondary" })
