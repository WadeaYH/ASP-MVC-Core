@{
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";
}


<h1>University Cafeteria | Suppliers</h1>

@{
    string[] suppliers = new string[] { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company", "Chocolate Delight", "Sweet Bakery" };
}

<ul class="list-group">
    <li class="list-group-item active" aria-current="true">Suppliers</li>
    @foreach (string supplier in suppliers)
    {
        <li class="list-group-item">@supplier</li>
    }
</ul>

<br />

@if (suppliers.Length >= 3)
{
<p> We have enough Suppliers</p>
}
else
{
<p>We need more suppliers</p>
}
