@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@section Script {
    <script>

        alert("Welcome to the Products Page!");
    </script>

    <link rel="stylesheet" href="~/css/Products.css" />
}

@{
    string[] products = new string[] { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate", "French Chocolate Cake", "Tea" };
}

<h1>University Cafeteria | Products</h1>

<ul class="list-group">
    <li class="list-group-item active" aria-current="true">Products</li>
    @foreach (string product in products)
    {
        string category;
        switch (product)
        {
            case "Water":
            case "Orange Juice":
            case "Coffee":
            case "Tea":
                category = "Drink";
                break;
            case "Sandwich":
            case "French Chocolate Cake":
                category = "Food";
                break;
            default:
                category = "Snack";
                break;
        }
        <li class="list-group-item">@product - @category</li>
    }
</ul>

<br />

@if (products.Length >= 3)
{
<p> We have enough Products</p>
}
else
{
<p>We need more products</p>
}