@model SupplyRequest
@{ ViewData["Title"] = "Request Details"; }
<h2>Supply Request #@Model.Id</h2>
<p><strong>Date:</strong> @Model.RequestDate.ToLocalTime().ToString("f")</p>
<p><strong>Requested by:</strong> @Model.User?.Email</p>
<p><strong>Status:</strong> <span class="badge bg-info">@Model.Status</span></p>
<table class="table"><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.Product?.Name</td><td>@item.Quantity</td><td>@item.Price.ToString("C")</td><td>@((item.Price * item.Quantity).ToString("C"))</td></tr> }
</tbody></table>
<h4>Total: @Model.TotalPrice.ToString("C")</h4>
@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) {
  <form asp-action="ChangeStatus" method="post" class="d-flex gap-2">
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-success" name="status" value="Approved">Approve</button>
    <button class="btn btn-danger" name="status" value="Rejected">Reject</button>
  </form>
}
@if (Model.Status == "Pending" && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || Model.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)) {
  <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
  <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"><button class="btn btn-outline-danger" onclick="return confirm('Delete this pending request?')">Delete</button></form>
}
<a asp-action="Index">Back</a>
