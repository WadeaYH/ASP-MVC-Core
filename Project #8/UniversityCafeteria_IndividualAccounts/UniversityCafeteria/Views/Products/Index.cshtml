@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex justify-content-between"><h2>Products</h2>
@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) { <a class="btn btn-primary" asp-action="Create">Add Product</a> }
</div>
<table class="table table-striped"><thead><tr><th>Name</th><th>Description</th><th>Price</th><th>Quantity</th><th></th></tr></thead><tbody>
@foreach (var p in Model) { <tr><td>@p.Name</td><td>@p.Description</td><td>@p.Price.ToString("C")</td><td>@p.Quantity</td><td><a asp-action="Details" asp-route-id="@p.Id">Details</a>
@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) { <span> | </span><a asp-action="Edit" asp-route-id="@p.Id">Edit</a>
<form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-link p-0" onclick="return confirm('Delete this product?')">Delete</button></form> }</td></tr> }
</tbody></table>
