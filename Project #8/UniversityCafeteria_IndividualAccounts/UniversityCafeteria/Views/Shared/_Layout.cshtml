<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - University Cafeteria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">University Cafeteria</a>
    <div class="navbar-nav me-auto">
      <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
      @if (User.Identity?.IsAuthenticated == true) {
        <a class="nav-link" asp-controller="SupplyRequest" asp-action="Index">Supply Requests</a>
        <a class="nav-link" asp-controller="SupplyRequest" asp-action="Create">New Request</a>
      }
      @if (User.IsInRole("SuperAdmin")) {
        <a class="nav-link" asp-controller="Admin" asp-action="Index">Manage Users</a>
      }
    </div>
    <div class="navbar-nav">
      @if (User.Identity?.IsAuthenticated == true) {
        <span class="navbar-text me-3">@User.Identity.Name</span>
        <form asp-controller="Account" asp-action="Logout" method="post">
          <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
        </form>
      } else {
        <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
      }
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
  @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
