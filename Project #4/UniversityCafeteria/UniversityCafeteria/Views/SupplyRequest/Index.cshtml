@using UniversityCafeteria.DTO
@model List<CreateSupplyRequest>
@{
    ViewBag.Title = "Create Supply Request";
    string? preferred = ViewBag.Preferred;
}

<div class="container mt-4">
    <h2>Create Supply Request</h2>

    <div class="card p-3 mb-4">
        <h5>Default priority</h5>
        <form asp-controller="SupplyRequest" asp-action="SavePreference" method="post" class="d-flex gap-2">
            <select name="priority" class="form-select w-auto">
                <option value="Normal" selected="@(preferred == "Normal")">Normal</option>
                <option value="Urgent" selected="@(preferred == "Urgent")">Urgent</option>
                <option value="Emergency" selected="@(preferred == "Emergency")">Emergency</option>
            </select>
            <button class="btn btn-secondary">Save Preference</button>
        </form>
        @if (preferred != null)
        {
            <p class="mt-2 mb-0">Your preferred request priority is @preferred.</p>
        }
    </div>

    <div class="card p-3 mb-4">
        <h5>Add a product</h5>
        <form asp-controller="SupplyRequest" asp-action="AddItem" method="post">
            <div class="mb-2">
                <label>Product Name</label>
                <input type="text" name="ProductName" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Category</label>
                <input type="text" name="Category" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Quantity</label>
                <input type="number" name="Quantity" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Unit Price</label>
                <input type="number" step="0.01" name="UnitPrice" class="form-control" />
            </div>
            <div class="mb-2">
                <label>Priority</label>
                <select name="Priority" class="form-select">
                    <option value="Normal" selected="@(preferred == "Normal")">Normal</option>
                    <option value="Urgent" selected="@(preferred == "Urgent")">Urgent</option>
                    <option value="Emergency" selected="@(preferred == "Emergency")">Emergency</option>
                </select>
            </div>
            <button class="btn btn-primary">Add Item</button>
        </form>
    </div>

    <h5>Products in the current request (@Model.Count)</h5>
    @if (Model.Count == 0)
    {
        <p>No products added yet.</p>
    }
    else
    {
        <ul>
            @foreach (var item in Model)
            {
                <li>@item.ProductName (@item.Category) - @item.Quantity x @item.UnitPrice JD - @item.Priority</li>
            }
        </ul>
        <a class="btn btn-success" href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>
    }
</div>
