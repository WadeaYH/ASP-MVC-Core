@using UniversityCafeteria.DTO
@model ReviewViewModel
@{
    ViewBag.Title = "Review Draft";
}

<div class="container mt-4">
    <h2>Review Draft</h2>

    @if (Model.Items.Count == 0)
    {
        <p>The draft is empty.</p>
        <a class="btn btn-primary" href="@Url.Action("Index", "SupplyRequest")">Add products</a>
    }
    else
    {
        <table class="table table-bordered">
            <tr>
                <th>Product</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Priority</th>
                <th>Total</th>
            </tr>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Category</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("0.00") JD</td>
                    <td>@item.Priority</td>
                    <td>@item.Total.ToString("0.00") JD</td>
                </tr>
            }
        </table>

        <table class="table w-auto">
            <tr><td>Subtotal</td><td>@Model.Subtotal.ToString("0.00") JD</td></tr>
            <tr><td>Preparation Fee (@Model.Priority)</td><td>@Model.PreparationFee.ToString("0.00") JD</td></tr>
            <tr><td>Discount</td><td>@Model.Discount.ToString("0.00") JD</td></tr>
            <tr><th>Final Total</th><th>@Model.FinalTotal.ToString("0.00") JD</th></tr>
        </table>

        <div class="d-flex gap-2">
            <form asp-controller="SupplyRequest" asp-action="ConfirmRequest" method="post">
                <button class="btn btn-success">Confirm Request</button>
            </form>
            <form asp-controller="SupplyRequest" asp-action="ClearDraft" method="post">
                <button class="btn btn-danger">Clear Draft</button>
            </form>
            <a class="btn btn-secondary" href="@Url.Action("Index", "SupplyRequest")">Add more products</a>
        </div>
    }
</div>
