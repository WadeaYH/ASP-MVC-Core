@{
}

@{
    <h1>@ViewData["PageTitle"]</h1>
    <p>Manager: @ViewData["ManagerName"]</p>
    <p>Number of Products: @ViewData["NumberOfProducts"]</p>
    <ul>
        @foreach (var product in (List<string>)ViewData["Products"])
        {
            <li>@product</li>
        }
    </ul>
}