@using Project5ORM.Models.CodeFirst


@model List<Category>
@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>

<p>@Html.ActionLink("Add Category", "Create", "Categories", null, new { @class = "btn btn-primary" })</p>

@if (Model.Count == 0)
{
    <p>No categories yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
        </tr>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
            </tr>
        }
    </table>
}
