@using Project5ORM.Models.CodeFirst


@model List<Product>
@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

<p>@Html.ActionLink("Add Product", "Create", "Products", null, new { @class = "btn btn-primary" })</p>

@if (Model.Count == 0)
{
    <p>No Products yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>CategoryId</th>
            <th>SupplierId</th>
        </tr>
        @foreach (var products in Model)
        {
            <tr>
                <td>@products.Id</td>
                <td>@products.Name</td>
                <td>@products.Price</td>
                <td>@products.Quantity</td>
                @if(products.Quantity < 5)
                {
                    <td>Low Stock</td>
                }
                else
                {
                    <td>In Stock</td>
                }
                <td>@products.CategoryId</td>
                <td>@products.SupplierId</td>
            </tr>
        }
    </table>
}
