@using Project5ORM.Models.CodeFirst

@model Product
@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Id)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Name)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Price)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Price)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Quantity)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Quantity)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CategoryId)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.CategoryId)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.SupplierId)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.SupplierId)</dd>
</dl>

@Html.ActionLink("Edit", "Edit", "Products", new { id = Model.Id }, new { @class = "btn btn-warning" })
@Html.ActionLink("Back to list", "Index", "Products", null, new { @class = "btn btn-secondary" })