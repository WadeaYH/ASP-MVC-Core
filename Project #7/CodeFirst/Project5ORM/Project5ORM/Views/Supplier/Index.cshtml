@using Project5ORM.Models.CodeFirst


@model List<Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<h2>Suppliers</h2>

<p>@Html.ActionLink("Add Supplier", "Create", "Supplier", null, new { @class = "btn btn-primary" })</p>

@if (Model.Count == 0)
{
    <p>No Suppliers yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Id</td>
                <td>@supplier.Name</td>
                <td>@supplier.Email</td>
                <td>@supplier.Phone</td>
                <td>
                    @Html.ActionLink("Details", "Details", "Supplier", new { id = supplier.Id }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Edit", "Edit", "Supplier", new { id = supplier.Id }, new { @class = "btn btn-warning btn-sm" })
                    @using (Html.BeginForm("Delete", "Supplier", new { id = supplier.Id }, FormMethod.Post, null, new { style = "display:inline", onsubmit = "return confirm('Are you sure you want to delete this supplier?');" }))
                    {
                        <button class="btn btn-danger btn-sm">Delete</button>
                    }
                </td>
            </tr>
        }
    </table>
}
