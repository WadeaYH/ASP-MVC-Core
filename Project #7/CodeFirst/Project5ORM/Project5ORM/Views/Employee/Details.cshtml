@using Project5ORM.Models.CodeFirst
@model Employee

<h2>@Model.FullName</h2>
<p>Position: @Model.Position</p>
<p>Salary: @Model.Salary</p>
<p>Hire date: @Model.HireDate</p>

<h4>Orders</h4>
@if (ViewBag.Orders.Count == 0)
{
    <p>No orders yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
        </tr>
        @foreach (var order in ViewBag.Orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CustomerName</td>
                <td>@order.OrderDate</td>
                <td>@order.TotalPrice</td>
                <td>@order.Status</td>
            </tr>
        }
    </table>
}