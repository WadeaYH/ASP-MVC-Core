@using Project5ORM.Models.CodeFirst


@model List<Employee>
@{
    ViewData["Title"] = "Employees";
}

<h2>Employees</h2>

<p>@Html.ActionLink("Add Employee", "Create", "Employee", null, new { @class = "btn btn-primary" })</p>

@if (Model.Count == 0)
{
    <p>No employees yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>FullName</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Actions</th>
        </tr>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.FullName</td>
                <td>@employee.Position</td>
                <td>@employee.Salary</td>
                <td>@employee.HireDate.ToShortDateString()</td>
                <td>
                    @Html.ActionLink("Details", "Details", "Employee", new { id = employee.Id }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Edit", "Edit", "Employee", new { id = employee.Id }, new { @class = "btn btn-warning btn-sm" })
                    @using (Html.BeginForm("Delete", "Employee", new { id = employee.Id }, FormMethod.Post, null, new { style = "display:inline", onsubmit = "return confirm('Are you sure you want to delete this employee?');" }))
                    {
                        <button class="btn btn-danger btn-sm">Delete</button>
                    }
                </td>
            </tr>
        }
    </table>
}
