@using Project5ORM.Models.CodeFirst

@model Category
@{
    ViewData["Title"] = "Category Details";
}

<h2>Category Details</h2>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Id)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Name)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Description)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Description)</dd>
</dl>

<table class="table table-bordered">
    <tr>
    <th>Id</th>
    <th>Name</th>
    <th>Price</th>
    <th>Quantity</th>
    <th>Status</th>
    <th>CategoryId</th>
    <th>SupplierId</th>
    <th>Actions</th>
    </tr>
@foreach (var products in ViewBag.Products)
{
<tr>
    <td>@products.Id</td>
    <td>@products.Name</td>
    <td>@products.Price</td>
    <td>@products.Quantity</td>
    @if (products.Quantity < 5)
    {
        <td>Low Stock</td>
    }
    else
    {
        <td>In Stock</td>
    }
    <td>@products.CategoryId</td>
    <td>@products.SupplierId</td>
    <td>
        @Html.ActionLink("Details", "Details", "Products", new { id = products.Id }, new { @class = "btn btn-info btn-sm" })
        @Html.ActionLink("Edit", "Edit", "Products", new { id = products.Id }, new { @class = "btn btn-warning btn-sm" })
        @using (Html.BeginForm("Delete", "Products", new { id = products.Id }, FormMethod.Post, null, new { style = "display:inline", onsubmit = "return confirm('Are you sure you want to delete this product?');" }))
        {
            <button class="btn btn-danger btn-sm">Delete</button>
        }
    </td>
</tr>
}
</table>

@Html.ActionLink("Edit", "Edit", "Categories", new { id = Model.Id }, new { @class = "btn btn-warning" })
@Html.ActionLink("Back to list", "Index", "Categories", null, new { @class = "btn btn-secondary" })