@using Project5ORM.Models.CodeFirst


@model List<Category>
@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>

<p>@Html.ActionLink("Add Category", "Create", "Categories", null, new { @class = "btn btn-primary" })</p>

@if (Model.Count == 0)
{
    <p>No categories yet.</p>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Products</th>
            <th>Actions</th>
        </tr>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>@ViewBag.Products.Count</td>
                <td>
                    @Html.ActionLink("Details", "Details", "Categories", new { id = category.Id }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Edit", "Edit", "Categories", new { id = category.Id }, new { @class = "btn btn-warning btn-sm" })
                    @using (Html.BeginForm("Delete", "Categories", new { id = category.Id }, FormMethod.Post, null, new { style = "display:inline", onsubmit = "return confirm('Are you sure you want to delete this category?');" }))
                    {
                        <button class="btn btn-danger btn-sm">Delete</button>
                    }
                </td>
            </tr>
        }
    </table>
}
